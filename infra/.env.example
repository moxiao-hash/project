# LangGraph SQLite 加密密钥：openssl rand -base64 32
LANGGRAPH_AES_KEY=

# 本地开发可留空，登录后在“AI 设置”中按用户配置。
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
MODEL_NAME=deepseek-v4-pro
MODEL_BASE_URL=https://api.deepseek.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
