# 当前默认使用 DeepSeek 的 OpenAI 兼容接口。
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Java 和 Python 必须配置成相同的内部服务令牌。
JAVA_BACKEND_BASE_URL=http://localhost:8080
INTERNAL_SERVICE_TOKEN=replace-with-a-local-random-token

# 每 15 分钟查询一次需要补跑的用户；Java 会按用户时区和幂等记录过滤。
NIGHTLY_ADJUSTMENT_INTERVAL_MINUTES=15

# 资料任务由 Python 定时领取；Qdrant 本地目录只允许单个 Uvicorn Worker 打开。
MATERIAL_PROCESSING_INTERVAL_SECONDS=10
MATERIAL_WORKER_ID=studypilot-ai-local
QDRANT_PATH=./data/qdrant

# 联网搜索 Key；为空时知识问答自动降级为仅本地资料。
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Agent 会话与 LangGraph checkpoint 使用同一加密 SQLite。
# 生成命令：openssl rand -base64 32
AGENT_STATE_DB_PATH=./data/agent-state.sqlite3
LANGGRAPH_AES_KEY=
# SQLite 版本只允许 1 个 FastAPI worker。
AGENT_WORKER_COUNT=1
