# 当前默认使用 DeepSeek 的 OpenAI 兼容接口。
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-pro
DEEPSEEK_API_KEY=

# Java 和 Python 必须配置成相同的内部服务令牌。
JAVA_BACKEND_BASE_URL=http://localhost:8080
INTERNAL_SERVICE_TOKEN=replace-with-a-local-random-token

# 每 15 分钟查询一次需要补跑的用户；Java 会按用户时区和幂等记录过滤。
NIGHTLY_ADJUSTMENT_INTERVAL_MINUTES=15
