### StudyPilot Roadmap Foundation 端到端联调
###
### 前置条件：
### 1. MySQL 与 Spring Boot 已启动，Java API 地址写入 baseUrl。
### 2. 在项目根目录创建 IntelliJ HTTP Client 私有环境文件 http-client.private.env.json：
###      {
###        "local": {
###          "baseUrl": "http://127.0.0.1:8080",
###          "email": "<未绑定过路线的本地联调账号>",
###          "password": "<本地测试密码>"
###        }
###      }
### 3. 在 IDEA HTTP 请求编辑器顶部选择 local 环境，再从上到下执行请求。
### 4. 私有环境文件已被根目录 .gitignore 忽略。本流程不接受客户端注入用户身份，
###    也不需要内部服务令牌或模型 Key。
### 5. 第 5 步验证新绑定路线的初始状态；请使用尚未推进过 Roadmap 的专用联调账号。
###
### 从上到下逐条执行。每个响应处理器都会验证关键契约并保存下一步所需变量。

### 1. 登录并保存短期访问令牌
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
  client.test("登录成功", function () {
    client.assert(response.status === 200, "登录应返回 200");
    client.assert(Boolean(response.body.accessToken), "响应应包含 accessToken");
  });
  client.global.set("accessToken", response.body.accessToken);
%}

### 2. 绑定 Java + AI Roadmap v1
POST {{baseUrl}}/api/roadmap-enrollments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "roadmapCode": "studypilot-java-ai",
  "templateVersion": 1
}

> {%
  client.test("路线绑定成功", function () {
    client.assert(response.status === 201, "绑定应返回 201");
    client.assert(response.body.roadmapCode === "studypilot-java-ai", "路线编码应匹配");
    client.assert(response.body.templateVersion === 1, "模板版本应为 1");
    client.assert(Boolean(response.body.id), "响应应包含 enrollmentId");
  });
  client.global.set("enrollmentId", response.body.id);
%}

### 3. 读取完整路线图，并保存首个阶段与节点 ID
GET {{baseUrl}}/api/roadmaps/current/map
Authorization: Bearer {{accessToken}}

> {%
  client.test("完整路线图符合 v1 目录", function () {
    client.assert(response.status === 200, "路线图查询应返回 200");
    client.assert(response.body.enrollmentId === client.global.get("enrollmentId"),
      "路线图应属于刚绑定的 enrollment");
    client.assert(response.body.stages.length === 12, "v1 应包含 12 个阶段");
    const nodeCount = response.body.stages.reduce((sum, stage) => sum + stage.nodes.length, 0);
    client.assert(nodeCount === 64, "v1 应包含 64 个节点");
    client.assert(response.body.stages[0].nodes.length > 0, "首阶段应至少包含一个节点");
  });
  client.global.set("stageId", response.body.stages[0].id);
  client.global.set("nodeId", response.body.stages[0].nodes[0].id);
%}

### 4. 读取首个阶段
GET {{baseUrl}}/api/roadmaps/current/stages/{{stageId}}
Authorization: Bearer {{accessToken}}

> {%
  client.test("阶段详情属于当前路线", function () {
    client.assert(response.status === 200, "阶段查询应返回 200");
    client.assert(response.body.id === client.global.get("stageId"), "阶段 ID 应匹配");
    client.assert(response.body.nodes.some(node => node.id === client.global.get("nodeId")),
      "阶段应包含已保存的首个节点");
  });
%}

### 5. 读取首个根节点并验证完整初始状态契约
GET {{baseUrl}}/api/roadmaps/current/nodes/{{nodeId}}
Authorization: Bearer {{accessToken}}

> {%
  client.test("根节点详情符合完整初始状态契约", function () {
    client.assert(response.status === 200, "节点查询应返回 200");
    client.assert(response.body.id === client.global.get("nodeId"), "节点 ID 应匹配");
    client.assert(["LOCKED", "AVAILABLE"].includes(response.body.availabilityStatus),
      "availabilityStatus 必须是已定义枚举");
    client.assert(["NOT_STARTED", "SCHEDULED", "IN_PROGRESS"].includes(response.body.learningStatus),
      "learningStatus 必须是已定义枚举");
    client.assert(["MISSING", "SUBMITTED"].includes(response.body.checkInStatus),
      "checkInStatus 必须是已定义枚举");
    client.assert(["NOT_GENERATED", "GENERATING", "READY", "EVALUATING", "PASSED", "FAILED",
      "PARTIALLY_GRADED"].includes(response.body.quizStatus), "quizStatus 必须是已定义枚举");
    client.assert(["NOT_REQUIRED", "MISSING", "SUBMITTED", "ACCEPTED", "REJECTED"]
      .includes(response.body.artifactStatus), "artifactStatus 必须是已定义枚举");
    client.assert(["INCOMPLETE", "COMPLETED"].includes(response.body.completionStatus),
      "completionStatus 必须是已定义枚举");
    client.assert(["COMPLETED", "LOCKED", "REVIEW_REQUIRED", "QUIZ_PENDING", "AVAILABLE",
      "SCHEDULED", "IN_PROGRESS"].includes(response.body.displayStatus),
      "displayStatus 必须是已定义枚举");

    client.assert(response.body.code === "java-syntax-oop", "首节点编码应稳定");
    client.assert(response.body.availabilityStatus === "AVAILABLE", "无前置依赖的首节点应可学习");
    client.assert(response.body.learningStatus === "NOT_STARTED", "首节点初始时尚未开始");
    client.assert(response.body.checkInStatus === "MISSING", "首节点初始时尚未打卡");
    client.assert(response.body.quizStatus === "NOT_GENERATED", "首节点初始时尚未生成测验");
    client.assert(response.body.artifactStatus === "MISSING", "首节点要求成果且初始时尚未提交");
    client.assert(response.body.completionStatus === "INCOMPLETE", "首节点初始时尚未完成");
    client.assert(response.body.displayStatus === "AVAILABLE", "首节点初始展示状态应为可学习");
  });
%}

### 6. 重复绑定同一版本，验证幂等且不创建第二条当前路线
POST {{baseUrl}}/api/roadmap-enrollments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "roadmapCode": "studypilot-java-ai",
  "templateVersion": 1
}

> {%
  client.test("重复绑定返回同一 enrollment", function () {
    client.assert(response.status === 201, "幂等绑定仍按创建契约返回 201");
    client.assert(response.body.id === client.global.get("enrollmentId"),
      "重复绑定必须返回相同 enrollmentId");
  });
%}

### 手动验收补充
### - 第 3 步应通过自动断言：12 个阶段、64 个节点。
### - 第 6 步应通过自动断言：两次绑定的 enrollmentId 完全相同。
### - 打开 http://localhost:5173/roadmap，确认图形与列表展示同一条路线；锁定节点应说明前置依赖。
### - 浏览器 Network 面板只能出现 Java /api/** 请求，不能出现 FastAPI /internal/** 请求。
